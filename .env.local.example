# Copy to .env.local. Never commit .env.local or private access links.

# Default: private links without account login.
# Set true and rebuild to restore the existing Firebase email/password login.
NEXT_PUBLIC_AUTH_ENABLED=false
# NEXT_PUBLIC_ALLOW_REGISTRATION=true

# Required for private-link mode, server-only. On Vercel, keep these non-public.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the PEM key with literal \n escapes between lines.
FIREBASE_ADMIN_PRIVATE_KEY=

# Existing users/{uid} IDs. Set these explicitly if multiple profiles exist.
AIVE_PRIMARY_USER_ID=
AIVE_PARTNER_USER_ID=
# Two DIFFERENT random secrets, at least 32 characters each.
# Generate each with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url'))"
AIVE_PRIMARY_LINK_KEY=
AIVE_PARTNER_LINK_KEY=

# Required only when restoring account login; preserved for that mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
